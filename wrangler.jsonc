{
  "name": "sdcardfinder",
  "compatibility_date": "2026-08-27",

  "main": "./worker/index.js",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "404-page"
  },

  "analytics_engine_datasets": [
    {
      "binding": "EVENTS",
      "dataset": "sdcardfinder_events"
    }
  ]
}